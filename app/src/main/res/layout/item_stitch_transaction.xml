<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="14dp" android:minHeight="80dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/transaction_name" style="@style/StitchSection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/transaction_amount" android:maxWidth="144dp" style="@style/StitchSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" />
    </LinearLayout>
    <TextView android:id="@+id/transaction_detail" style="@style/StitchBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
        <TextView android:id="@+id/transaction_type" style="@style/StitchBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/stitch_badge_success" android:paddingHorizontal="8dp" android:paddingVertical="4dp" />
        <TextView android:id="@+id/transaction_status" style="@style/StitchBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/stitch_badge_success" android:layout_marginStart="4dp" android:paddingHorizontal="8dp" android:paddingVertical="4dp" />
        <TextView android:id="@+id/transaction_plot" style="@style/StitchSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:layout_marginStart="8dp" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="@color/stitch_divider" />
</LinearLayout>