<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mobile_dark"
        android:padding="18dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/summary_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/MobileTitle"
            android:textColor="@color/on_primary" />
        <TextView
            android:id="@+id/summary_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/MobileBody"
            android:textColor="@color/on_primary" />
    </LinearLayout>
    <TextView
        android:id="@+id/summary_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textAppearance="@style/MobileLabel"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>