<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    android:clipToPadding="false">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="0dp"
        app:layout_constraintWidth_max="560dp" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_brand_mark"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="MyFarmio"
            android:textAppearance="@style/MobileLabel" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tu campo, más cerca"
            android:textAppearance="@style/MobileTitle"
            android:accessibilityHeading="true" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Ingresá con tu cuenta para continuar con la operación de tu campo."
            android:textAppearance="@style/MobileBody" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/login_email_layout"
            style="@style/MobileInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Correo electrónico"
            app:errorEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/login_password_layout"
            style="@style/MobileInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contraseña"
            app:endIconMode="password_toggle"
            app:errorEnabled="true">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:id="@+id/text_error_general"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:background="@drawable/bg_error"
            android:textAppearance="@style/MobileBody"
            android:textColor="@color/on_error_container"
            android:visibility="gone"
            android:accessibilityLiveRegion="assertive" />
        <ProgressBar
            android:id="@+id/login_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:layout_marginTop="12dp"
            android:visibility="invisible"
            android:contentDescription="Iniciando sesión" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_submit"
            style="@style/MobileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ingresar"
            android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_recovery_help"
            style="@style/MobileQuietButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="¿Olvidaste tu contraseña?" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_google" style="@style/MobileOutlineButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="Ingresar con Google" android:enabled="false"
            android:contentDescription="Ingresar con Google. Próximamente, no disponible." />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Google estará disponible próximamente." android:textAppearance="@style/MobileBody"
            android:gravity="center" android:layout_marginTop="4dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/outline_variant" android:layout_marginVertical="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Conocé MyFarmio antes de empezar" android:textAppearance="@style/MobileSection" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Recorré un campo de ejemplo. Los cambios de la demo no se guardan en tu organización."
            android:textAppearance="@style/MobileBody" android:layout_marginTop="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_demo" style="@style/MobileOutlineButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="16dp" android:text="Explorar demostración" />
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
