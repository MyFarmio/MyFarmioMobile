<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8faf5">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true"
                android:background="#ffffff">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/logo_myfarmio"
                            android:scaleType="fitCenter"
                            android:contentDescription="@null" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_brand_title"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="#154212"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/brand_tagline"
                                android:textSize="10sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.2"
                                android:textColor="#79564b" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Header -->
                    <TextView
                        android:id="@+id/text_header_small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/access_private"
                        android:textSize="11sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.2"
                        android:textColor="#79564b"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/text_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/login_title"
                        android:textSize="32sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="#154212"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/text_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/login_subtitle"
                        android:textSize="14sp"
                        android:textColor="#6b7280"
                        android:layout_marginTop="6dp"
                        android:lineSpacingMultiplier="1.5" />

                    <!-- Form -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="24dp">

                        <!-- CORREO -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_email"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.18"
                            android:textColor="#78716c"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="6dp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundMode="filled"
                            app:boxBackgroundColor="#ecefea"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="2dp"
                            app:boxStrokeColor="#154212"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_email"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:textSize="14sp"
                                android:textColor="#191c1a"
                                android:textColorHint="#9ca3af"
                                android:inputType="textEmailAddress" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- CONTRASEÑA -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_password"
                            android:textSize="11sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.18"
                            android:textColor="#78716c"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="6dp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:boxBackgroundMode="filled"
                            app:boxBackgroundColor="#ecefea"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="2dp"
                            app:boxStrokeColor="#154212"
                            app:boxCornerRadiusTopStart="8dp"
                            app:boxCornerRadiusTopEnd="8dp"
                            app:boxCornerRadiusBottomEnd="8dp"
                            app:boxCornerRadiusBottomStart="8dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/input_password"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:textSize="14sp"
                                android:textColor="#191c1a"
                                android:textColorHint="#9ca3af"
                                android:inputType="textPassword" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Botón principal -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_submit"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="24dp"
                            android:backgroundTint="#154212"
                            app:cornerRadius="8dp"
                            android:text="@string/enter_system"
                            android:textAllCaps="true"
                            android:textSize="13sp"
                            android:textColor="#FFFFFF"
                            android:letterSpacing="0.12"
                            android:textStyle="bold"
                            app:iconGravity="textEnd"
                            app:iconPadding="10dp"
                            app:iconSize="20dp"
                            app:iconTint="#FFFFFF"
                            app:icon="@drawable/ic_flecha_derecha_circulo" />

                        <!-- Separador -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="16dp">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="#e5e7eb" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/separator_o"
                                android:textSize="11sp"
                                android:textColor="#9ca3af"
                                android:paddingLeft="12dp"
                                android:paddingRight="12dp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1"
                                android:background="#e5e7eb" />

                        </LinearLayout>

                        <!-- Google button -->
                        <LinearLayout
                            android:id="@+id/button_google"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:background="@drawable/bg_google_button">

                            <TextView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:gravity="center"
                                android:text="@string/google_g"
                                android:textSize="12sp"
                                android:textColor="#154212"
                                android:fontFamily="sans-serif-black"
                                android:background="@drawable/bg_circle_border" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/continue_google"
                                android:textSize="13sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.12"
                                android:textStyle="bold"
                                android:textColor="#191c1a"
                                android:layout_marginStart="12dp" />

                        </LinearLayout>

                        <!-- Error -->
                        <TextView
                            android:id="@+id/text_error_general"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:layout_marginTop="12dp"
                            android:padding="12dp"
                            android:background="@drawable/bg_error"
                            android:textColor="#93000a"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/demo_login_hint"
                            android:textColor="#9ca3af"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
