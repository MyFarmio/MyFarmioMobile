<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:minHeight="64dp"
    android:paddingVertical="12dp">
    <TextView
        android:id="@+id/tv_crop_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/MobileSection" />
    <TextView
        android:id="@+id/tv_crop_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/MobileBody"
        android:layout_marginTop="4dp" />
    <TextView
        android:id="@+id/tv_crop_percent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/MobileLabel"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/pb_crop"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:visibility="gone"
        android:progressTint="@color/primary" />
</LinearLayout>