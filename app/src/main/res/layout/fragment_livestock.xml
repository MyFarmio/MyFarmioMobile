<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GESTIÓN GANADERA" android:textColor="#79564B" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.16" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Rodeos y animales" android:textColor="#154212" android:textSize="29sp" android:textStyle="bold" android:fontFamily="sans-serif-black" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_livestock_filter" android:layout_width="48dp" android:layout_height="48dp" android:text="" android:contentDescription="Filtrar ganado" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#E6F1E1" app:cornerRadius="24dp" app:icon="@drawable/ic_pets" app:iconTint="#154212" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Localizá rodeos, revisá su estado sanitario y registrá novedades de la jornada." android:textColor="#646862" android:textSize="14sp" android:lineSpacingExtra="3dp" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="#154212" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESUMEN DEL RODEO" android:textColor="#BCF0AE" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.14" />
                <TextView android:id="@+id/tv_livestock_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0 animales" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_livestock_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Sin novedades sanitarias pendientes" android:textColor="#D8E8D2" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:boxBackgroundMode="filled" app:boxBackgroundColor="#ECEFEA" app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/input_livestock_search" android:layout_width="match_parent" android:layout_height="52dp" android:hint="Buscar por caravana, rodeo o categoría" android:paddingHorizontal="16dp" android:textColor="#191C1A" android:textColorHint="#72796E" android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ANIMALES A SEGUIR" android:textColor="#79564B" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.14" />
            <TextView android:id="@+id/tv_livestock_count" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="10dp" android:text="0" android:textColor="#154212" android:textSize="11sp" android:textStyle="bold" android:background="@drawable/bg_field_status" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ll_livestock_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
