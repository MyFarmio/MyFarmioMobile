<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/MobileCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/record_status"
                style="@style/MobileBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/record_signal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/MobileLabel" />
        </LinearLayout>
        <TextView
            android:id="@+id/record_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/MobileSection" />
        <TextView
            android:id="@+id/record_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/MobileBody"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/record_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/MobileBody" />
        <ProgressBar
            android:id="@+id/record_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:progressTint="@color/primary"
            android:progressBackgroundTint="@color/surface_container"
            android:visibility="gone" />
        <LinearLayout android:id="@+id/record_metrics" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/record_metric_one" style="@style/StitchMetricLabel"
                android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1"
                android:layout_marginEnd="4dp" android:padding="7dp" android:gravity="center"
                android:background="@drawable/bg_stitch_inset" />
            <TextView android:id="@+id/record_metric_two" style="@style/StitchMetricLabel"
                android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1"
                android:layout_marginHorizontal="4dp" android:padding="7dp" android:gravity="center"
                android:background="@drawable/bg_stitch_inset" />
            <TextView android:id="@+id/record_metric_three" style="@style/StitchMetricLabel"
                android:layout_width="0dp" android:layout_height="58dp" android:layout_weight="1"
                android:layout_marginStart="4dp" android:padding="7dp" android:gravity="center"
                android:background="@drawable/bg_stitch_inset" />
        </LinearLayout>
        <TextView
            android:id="@+id/record_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ver detalle →"
            android:textAppearance="@style/MobileLabel"
            android:importantForAccessibility="no" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
