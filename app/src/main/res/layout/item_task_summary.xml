<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/task_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#ffffff">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_task_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDIENTE"
                android:textAllCaps="true"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#ba1a1a"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:background="@drawable/bg_priority_high" />

            <TextView
                android:id="@+id/tv_task_due"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="09 jun 2026"
                android:textSize="10sp"
                android:textColor="#8b7d75" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Reponer stock de urea"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#191c1a" />

        <TextView
            android:id="@+id/tv_task_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Stock actual por debajo del objetivo operativo."
            android:textSize="13sp"
            android:textColor="#6b7280" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tv_task_responsible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Responsable: Juan Pérez"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#154212" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_task_details"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Ver detalle"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                android:backgroundTint="#eef2ea"
                android:textColor="#154212" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
