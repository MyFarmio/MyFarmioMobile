<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/task_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
    app:cardBackgroundColor="#FFFFFF" app:cardCornerRadius="18dp" app:cardElevation="1dp" app:strokeColor="#E1E3DE" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_task_status" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center" android:paddingHorizontal="10dp" android:background="@drawable/bg_priority_high" android:text="PENDIENTE" android:textColor="#93000A" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_task_due" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:text="09 jun 2026" android:textColor="#72796E" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="#154212" android:textSize="28sp" />
        </LinearLayout>
        <TextView android:id="@+id/tv_task_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Reponer stock de urea" android:textColor="#191C1A" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_task_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:maxLines="2" android:ellipsize="end" android:textColor="#646862" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical">
            <TextView android:id="@+id/tv_task_responsible" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center_vertical" android:textColor="#154212" android:textSize="13sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_task_details" android:layout_width="44dp" android:layout_height="44dp" android:text="" android:contentDescription="Ver detalle" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#E6F1E1" app:cornerRadius="22dp" app:icon="@drawable/ic_arrow_forward" app:iconTint="#154212" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
