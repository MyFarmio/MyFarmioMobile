<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f8faf5">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:background="#f8faf5">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/logo_myfarmio"
                        android:scaleType="fitCenter"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_brand_title"
                            android:textSize="18sp"
                            android:textColor="#154212"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/brand_tagline"
                            android:textSize="10sp"
                            android:textAllCaps="true"
                            android:letterSpacing="0.2"
                            android:textColor="#79564b" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_header"
                    android:textSize="11sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.2"
                    android:textColor="#79564b"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dashboard_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_title_default"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="#154212"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_sub"
                    android:textSize="13sp"
                    android:textColor="#6b7280"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.4" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="true"
                    android:layout_marginTop="14dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_fields"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#ffffff">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_alert_icon"
                                android:src="@drawable/ic_exclamacion"
                                android:padding="7dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_alerts"
                                android:textSize="10sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:textColor="#78716c"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/tv_alert_plots"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="32sp"
                                android:textColor="#191c1a"
                                android:fontFamily="sans-serif-black"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tv_alert_plots_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 lotes / 0 ha"
                                android:textSize="12sp"
                                android:textColor="#9ca3af" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_tasks"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#ffffff">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_tasks_icon"
                                android:src="@drawable/ic_lista_tareas"
                                android:padding="7dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_tasks"
                                android:textSize="10sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:textColor="#78716c"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/tv_critical_tasks"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="32sp"
                                android:textColor="#191c1a"
                                android:fontFamily="sans-serif-black"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tv_critical_tasks_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 vencen hoy"
                                android:textSize="12sp"
                                android:textColor="#9ca3af" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_livestock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#ffffff">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_livestock_icon"
                                android:src="@drawable/ic_circulo_discontinuo"
                                android:padding="7dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_livestock"
                                android:textSize="10sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:textColor="#78716c"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/tv_livestock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="32sp"
                                android:textColor="#191c1a"
                                android:fontFamily="sans-serif-black"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tv_livestock_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 animales / 0 rodeos"
                                android:textSize="12sp"
                                android:textColor="#9ca3af" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_finance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#ffffff">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_finance_icon"
                                android:src="@drawable/ic_grafico_histograma"
                                android:padding="7dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_finance"
                                android:textSize="10sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"
                                android:textColor="#78716c"
                                android:textStyle="bold"
                                android:layout_marginTop="12dp" />

                            <TextView
                                android:id="@+id/tv_finance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="28sp"
                                android:textColor="#191c1a"
                                android:fontFamily="sans-serif-black"
                                android:layout_marginTop="2dp" />

                            <TextView
                                android:id="@+id/tv_finance_detail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 registros pendientes"
                                android:textSize="12sp"
                                android:textColor="#9ca3af" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </GridLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#ffffff"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_weather"
                                android:textSize="10sp"
                                android:textAllCaps="true"
                                android:letterSpacing="0.2"
                                android:textColor="#79564b"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_weather_expand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_expand"
                                android:textSize="10sp"
                                android:textAllCaps="true"
                                android:textColor="#154212"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/tv_weather_location"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/loading"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#191c1a" />

                            <TextView
                                android:id="@+id/tv_weather_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/temp_placeholder"
                                android:textSize="20sp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="#154212" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_weather_condition"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="12sp"
                            android:textColor="#9ca3af"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#ffffff"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Alertas que mueven el día"
                                    android:textSize="18sp"
                                    android:textColor="#154212"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Prioridades desde tareas, campos, finanzas y ganado."
                                    android:textSize="12sp"
                                    android:textColor="#9ca3af"
                                    android:layout_marginTop="2dp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_ver_tareas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_view_tasks"
                                android:textAllCaps="true"
                                android:textSize="10sp"
                                android:textColor="#79564b"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_alerts_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#ffffff"
                    android:layout_marginTop="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_campaign_pulse"
                                android:textSize="18sp"
                                android:textColor="#154212"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_ver_campos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_view_fields"
                                android:textAllCaps="true"
                                android:textSize="10sp"
                                android:textColor="#79564b"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_crop_pulse_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#eef2ea"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_agenda"
                                android:textSize="18sp"
                                android:textColor="#154212"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_ver_calendario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_calendar"
                                android:textAllCaps="true"
                                android:textSize="10sp"
                                android:textColor="#79564b"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/ll_agenda_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progress_overlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>
