<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:paddingBottom="24dp">
                <TextView
                    android:id="@+id/tv_dashboard_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/MobileLabel"
                    android:text="RESUMEN OPERATIVO" />
                <TextView
                    android:id="@+id/tv_dashboard_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/MobileTitle"
                    android:text="Tu campo, hoy"
                    android:layout_marginTop="6dp"
                    android:accessibilityHeading="true" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/MobileBody"
                    android:text="Lo importante para empezar la jornada."
                    android:layout_marginTop="4dp" />
                <include
                    layout="@layout/include_mobile_state" />
                <TextView android:id="@+id/dashboard_source" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="16dp"
                    android:padding="12dp" android:background="@drawable/bg_mobile_badge"
                    android:textAppearance="@style/MobileLabel" android:textColor="@color/primary" />
                <LinearLayout
                    android:id="@+id/dashboard_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.card.MaterialCardView
                        style="@style/MobileCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/MobileSection"
                                android:text="Requiere tu atención"
                                android:accessibilityHeading="true" />
                            <LinearLayout
                                android:id="@+id/ll_alerts_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="12dp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/tv_ver_tareas"
                                style="@style/MobileButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="Revisar tareas" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_tasks"
                            style="@style/MobileCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="152dp"
                                android:orientation="vertical"
                                android:padding="14dp">
                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_task_alt"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileLabel"
                                    android:text="Labores críticas"
                                    android:layout_marginTop="10dp" />
                                <TextView
                                    android:id="@+id/tv_critical_tasks"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileTitle"
                                    android:text="—"
                                    android:layout_marginTop="4dp" />
                                <TextView
                                    android:id="@+id/tv_critical_tasks_detail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileBody"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_fields"
                            style="@style/MobileCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="152dp"
                                android:orientation="vertical"
                                android:padding="14dp">
                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_map"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileLabel"
                                    android:text="Lotes con alerta"
                                    android:layout_marginTop="10dp" />
                                <TextView
                                    android:id="@+id/tv_alert_plots"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileTitle"
                                    android:text="—"
                                    android:layout_marginTop="4dp" />
                                <TextView
                                    android:id="@+id/tv_alert_plots_detail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileBody"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                    <com.google.android.material.card.MaterialCardView
                        style="@style/MobileCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/MobileSection"
                                android:text="Clima para decidir"
                                android:accessibilityHeading="true" />
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/MobileBody"
                                android:text="El pronóstico todavía no está conectado en Android. Revisá las condiciones locales antes de planificar labores."
                                android:layout_marginTop="8dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        style="@style/MobileCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/MobileSection"
                                android:text="Pulso de campaña"
                                android:accessibilityHeading="true" />
                            <LinearLayout
                                android:id="@+id/ll_crop_pulse_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="12dp" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/dashboard_fields"
                                style="@style/MobileQuietButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Ver mis campos" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false">
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_livestock"
                            style="@style/MobileCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="152dp"
                                android:orientation="vertical"
                                android:padding="14dp">
                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_pets"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileLabel"
                                    android:text="Rodeos registrados"
                                    android:layout_marginTop="10dp" />
                                <TextView
                                    android:id="@+id/tv_livestock"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileTitle"
                                    android:text="—"
                                    android:layout_marginTop="4dp" />
                                <TextView
                                    android:id="@+id/tv_livestock_detail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileBody"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_finance"
                            style="@style/MobileCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_margin="4dp"
                            android:clickable="true"
                            android:focusable="true">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="152dp"
                                android:orientation="vertical"
                                android:padding="14dp">
                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_payments"
                                    android:importantForAccessibility="no" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileLabel"
                                    android:text="Balance registrado"
                                    android:layout_marginTop="10dp" />
                                <TextView
                                    android:id="@+id/tv_finance"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileTitle"
                                    android:text="—"
                                    android:layout_marginTop="4dp" />
                                <TextView
                                    android:id="@+id/tv_finance_detail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/MobileBody"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                    <com.google.android.material.card.MaterialCardView
                        style="@style/MobileCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/MobileSection"
                                android:id="@+id/dashboard_agenda_title"
                                android:text="Agenda registrada"
                                android:accessibilityHeading="true" />
                            <LinearLayout
                                android:id="@+id/ll_agenda_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:layout_marginTop="12dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <!-- This ID intentionally belongs to a FrameLayout, not a ProgressBar. -->
    <FrameLayout
        android:id="@+id/progress_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:visibility="gone">
        <include
            layout="@layout/include_mobile_skeleton"
            android:id="@+id/dashboard_skeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible" />
    </FrameLayout>
</FrameLayout>
