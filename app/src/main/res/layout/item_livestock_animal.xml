<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/MobileCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:id="@+id/tv_animal_tag" style="@style/MobileSection" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/><TextView android:id="@+id/tv_animal_status" style="@style/MobileBadge" android:layout_width="wrap_content" android:layout_height="wrap_content"/></LinearLayout>
        <TextView android:id="@+id/tv_animal_meta" style="@style/MobileBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"><TextView android:id="@+id/tv_animal_weight" style="@style/MobileLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/><TextView android:id="@+id/tv_animal_location" style="@style/MobileBody" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
