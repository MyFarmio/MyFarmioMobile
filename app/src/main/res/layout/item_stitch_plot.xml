<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_stitch_card" android:padding="16dp" android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/record_zone" style="@style/StitchSmall" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        <TextView android:id="@+id/record_status" style="@style/StitchBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/stitch_badge_caution" android:paddingHorizontal="8dp" android:paddingVertical="4dp" />
    </LinearLayout>
    <TextView android:id="@+id/record_title" style="@style/StitchSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="21sp" android:textColor="@color/stitch_primary" android:layout_marginTop="6dp" />
    <TextView android:id="@+id/record_subtitle" style="@style/StitchBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="20dp">
        <TextView style="@style/StitchMetricLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="AVANCE CAMPAÑA" />
        <TextView android:id="@+id/record_progress_label" style="@style/StitchMetricLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/stitch_primary" />
    </LinearLayout>
    <ProgressBar android:id="@+id/record_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="10dp" android:progressDrawable="@drawable/stitch_progress" android:max="100" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="@color/stitch_divider" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_stitch_inset" android:layout_marginHorizontal="2dp">
            <TextView style="@style/StitchMetricLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ETAPA" android:gravity="center" />
            <TextView android:id="@+id/record_metric_one" style="@style/StitchBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:gravity="center" android:textColor="@color/on_surface" android:textStyle="bold" android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_stitch_inset" android:layout_marginHorizontal="2dp">
            <TextView style="@style/StitchMetricLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HUMEDAD" android:gravity="center" />
            <TextView android:id="@+id/record_metric_two" style="@style/StitchBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:gravity="center" android:textColor="@color/on_surface" android:textStyle="bold" android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_stitch_inset" android:layout_marginHorizontal="2dp">
            <TextView style="@style/StitchMetricLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RINDE" android:gravity="center" />
            <TextView android:id="@+id/record_metric_three" style="@style/StitchBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:gravity="center" android:textColor="@color/on_surface" android:textStyle="bold" android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>