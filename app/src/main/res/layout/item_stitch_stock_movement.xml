<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp" android:paddingBottom="12dp">
    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:src="@drawable/st_south_east" app:tint="@color/stitch_primary" android:importantForAccessibility="no" android:padding="7dp" android:background="@drawable/stitch_badge_neutral" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginHorizontal="12dp">
        <TextView android:id="@+id/stock_name" style="@style/StitchSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" />
        <TextView android:id="@+id/stock_detail" style="@style/StitchSmall" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
    </LinearLayout>
    <TextView android:id="@+id/stock_quantity" style="@style/StitchBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/stitch_primary" />
</LinearLayout>