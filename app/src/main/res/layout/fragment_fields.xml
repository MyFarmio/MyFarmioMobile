<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F8FAF5">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingBottom="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GESTIÓN DE CAMPOS" android:textColor="#79564B" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.16"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Campaña y lotes" android:textColor="#154212" android:textSize="29sp" android:textStyle="bold" android:fontFamily="sans-serif-black" /></LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_fields_sync" android:layout_width="48dp" android:layout_height="48dp" android:text="" android:contentDescription="Actualizar lotes" android:insetTop="0dp" android:insetBottom="0dp" android:backgroundTint="#154212" app:cornerRadius="24dp" app:icon="@drawable/ic_arrow_forward" app:iconTint="#FFFFFF" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Seguimiento de superficie, humedad y rendimiento. Disponible también sin conexión." android:textColor="#646862" android:textSize="14sp" android:lineSpacingExtra="3dp"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" app:cardBackgroundColor="#154212" app:cardCornerRadius="20dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LOTES DISPONIBLES" android:textColor="#BCF0AE" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.14"/><TextView android:id="@+id/tv_fields_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Datos guardados en el dispositivo" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Actualizá al recuperar señal para obtener el estado más reciente." android:textColor="#D8E8D2" android:textSize="13sp" /></LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="LOTES ACTIVOS" android:textColor="#79564B" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.14"/><TextView android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center" android:text="Ver detalle" android:textColor="#154212" android:textStyle="bold" /></LinearLayout>
        <LinearLayout android:id="@+id/ll_fields" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
