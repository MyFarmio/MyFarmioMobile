                    <TextView android:id="@+id/finance_budget_count" style="@style/StitchBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:background="@drawable/stitch_badge_neutral" android:paddingHorizontal="8dp" android:paddingVertical="4dp" />
                </LinearLayout>
                <TextView android:id="@+id/finance_budget_detail" style="@style/StitchBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin lectura disponible" android:layout_marginTop="8dp" />
            </LinearLayout>
