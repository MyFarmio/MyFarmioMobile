<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MobileOutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <!-- Shared native design tokens; colors come from the original MyFarmio palette. -->
    <style
        name="MobileTitle"
        parent="TextAppearance.MyFarmio.DisplayLarge">
        <item
            name="android:textColor">@color/primary</item>
        <item
            name="android:textSize">26sp</item>
        <item
            name="android:textStyle">bold</item>
    </style>
    <style
        name="MobileSection"
        parent="TextAppearance.MyFarmio.TitleLarge">
        <item
            name="android:textColor">@color/primary</item>
        <item
            name="android:textSize">18sp</item>
        <item
            name="android:textStyle">bold</item>
    </style>
    <style
        name="MobileBody"
        parent="TextAppearance.MyFarmio.BodyMedium">
        <item
            name="android:lineSpacingExtra">3dp</item>
        <item
            name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style
        name="MobileLabel"
        parent="TextAppearance.MyFarmio.LabelMedium">
        <item
            name="android:textColor">@color/secondary</item>
        <item
            name="android:textStyle">bold</item>
    </style>
    <style
        name="MobileCard"
        parent="Widget.Material3.CardView.Outlined">
        <item
            name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item
            name="cardCornerRadius">20dp</item>
        <item
            name="cardElevation">0dp</item>
        <item
            name="strokeColor">@color/surface_container_high</item>
        <item
            name="strokeWidth">1dp</item>
    </style>
    <style
        name="MobileButton"
        parent="Widget.Material3.Button">
        <item
            name="android:minHeight">48dp</item>
        <item
            name="android:insetTop">0dp</item>
        <item
            name="android:insetBottom">0dp</item>
        <item
            name="cornerRadius">14dp</item>
        <item
            name="android:textAllCaps">false</item>
    </style>
    <style
        name="MobileQuietButton"
        parent="Widget.Material3.Button.TextButton">
        <item
            name="android:minHeight">48dp</item>
        <item
            name="android:minWidth">48dp</item>
        <item
            name="android:insetTop">0dp</item>
        <item
            name="android:insetBottom">0dp</item>
        <item
            name="android:textAllCaps">false</item>
    </style>
    <style
        name="MobileInput"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item
            name="boxCornerRadiusTopStart">14dp</item>
        <item
            name="boxCornerRadiusTopEnd">14dp</item>
        <item
            name="boxCornerRadiusBottomStart">14dp</item>
        <item
            name="boxCornerRadiusBottomEnd">14dp</item>
        <item
            name="boxBackgroundColor">@color/surface_container_lowest</item>
    </style>
    <style
        name="MobileBadge"
        parent="MobileLabel">
        <item
            name="android:background">@drawable/bg_mobile_badge</item>
        <item
            name="android:paddingHorizontal">10dp</item>
        <item
            name="android:paddingVertical">6dp</item>
        <item
            name="android:textColor">@color/primary</item>
    </style>
</resources>
