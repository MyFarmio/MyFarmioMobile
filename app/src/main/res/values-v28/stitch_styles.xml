<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="StitchBody">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontVariationSettings">"'wght' 400"</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="StitchTitle" parent="StitchBody">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontVariationSettings">"'wght' 800"</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="StitchSection" parent="StitchTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:fontVariationSettings">"'wght' 700"</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="StitchEyebrow" parent="StitchBody">
        <item name="android:textSize">11sp</item>
        <item name="android:fontVariationSettings">"'wght' 700"</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textColor">@color/secondary</item>
    </style>
    <style name="StitchNavText" parent="StitchSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:fontVariationSettings">"'wght' 500"</item>
    </style>
</resources>
